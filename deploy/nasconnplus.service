[Unit]
Description=nasconn+ Seamless IPv6 Relay & HTTPS Upgrade Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nasconnplus
Group=nasconnplus
# Adjust the binary path if installed elsewhere
ExecStart=/usr/local/bin/nasconnplus -c /etc/nasconnplus/config.json
Restart=always
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Resource and limit configurations
LimitNOFILE=16384
LimitNPROC=16384
TasksMax=1024
MemoryMax=256M
RuntimeDirectory=nasconnplus
RuntimeDirectoryMode=0755

# Security sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/nasconnplus /run
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Ambient capabilities for binding low ports (e.g. 80, 443)
# Note: CAP_SYS_PTRACE has been eliminated via /proc/self/fd socket inode tracking.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
