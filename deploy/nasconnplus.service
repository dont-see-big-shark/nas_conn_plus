[Unit]
Description=nasconn+ Seamless IPv6 Relay & HTTPS Upgrade Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Adjust the binary path if installed elsewhere
ExecStart=/usr/local/bin/nasconnplus -c /etc/nasconnplus/config.json
Restart=always
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Resource and limit configurations
LimitNOFILE=16384
LimitNPROC=16384
TasksMax=1024

# Security sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/nasconnplus /run /tmp
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Ambient capabilities for binding low ports and inspecting socket inodes
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
